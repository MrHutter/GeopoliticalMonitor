<Window
    x:Class="GeopoliticalMonitor.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:GeopoliticalMonitor.Desktop">
  <Grid
      x:Name="RootGrid"
      Background="#000000"
      Loaded="OnRootGridLoaded"
      SizeChanged="OnRootGridSizeChanged">
    <Grid.Resources>
      <Style x:Key="XChromeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#040404" />
        <Setter Property="BorderBrush" Value="#242426" />
        <Setter Property="Foreground" Value="#C9CCD1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="30" />
      </Style>
      <Style x:Key="XOverflowMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource XChromeButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="#070707" />
        <Setter Property="BorderBrush" Value="#1F2023" />
        <Setter Property="Padding" Value="10,7" />
      </Style>
    </Grid.Resources>

    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="AppColumn" Width="*" MinWidth="940" />
      <ColumnDefinition x:Name="SplitterColumn" Width="10" />
      <ColumnDefinition x:Name="XPaneColumn" Width="420" MinWidth="320" />
    </Grid.ColumnDefinitions>

    <controls:WebView2 x:Name="AppWebView" Grid.Column="0" />

    <Button
        x:Name="ShowXPaneButton"
        Grid.Column="0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,12,12,0"
        Padding="12,7"
        Background="#040404"
        BorderBrush="#242426"
        Foreground="#D4D6DA"
        Click="OnShowXPaneClicked"
        Visibility="Collapsed">
      Show X
    </Button>

    <local:HorizontalResizeGrip
        x:Name="XPaneSplitter"
        Grid.Column="1"
        Background="Transparent"
        PointerEntered="OnXPaneSplitterPointerEntered"
        PointerExited="OnXPaneSplitterPointerExited"
        PointerPressed="OnXPaneSplitterPointerPressed"
        PointerMoved="OnXPaneSplitterPointerMoved"
        PointerReleased="OnXPaneSplitterPointerReleased"
        PointerCanceled="OnXPaneSplitterPointerCanceled"
        PointerCaptureLost="OnXPaneSplitterPointerCaptureLost">
      <Grid>
        <Border
            x:Name="XPaneSplitterGlow"
            Width="7"
            HorizontalAlignment="Center"
            Background="Transparent"
            Opacity="0" />
        <Border
            x:Name="XPaneSplitterLine"
            Width="1"
            HorizontalAlignment="Center"
            Background="#151515" />
      </Grid>
    </local:HorizontalResizeGrip>

    <Grid
        x:Name="XPane"
        Grid.Column="2"
        BorderBrush="#202020"
        BorderThickness="1,0,0,0"
        Background="#020202">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Padding="10,8" Background="#020202" BorderBrush="#202020" BorderThickness="0,0,0,1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border x:Name="XHeaderAccentBar" Width="3" Height="32" Background="#FF7A18" />
            <StackPanel>
              <TextBlock x:Name="XHeaderEyebrow" Text="MY X FEED" Foreground="#FFB347" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="X Website" Foreground="#D4D6DA" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button
                x:Name="XMoveSideButton"
                MinWidth="34"
                Content="Move Left"
                Click="OnMoveXPaneSideClicked"
                Style="{StaticResource XChromeButtonStyle}"
                ToolTipService.ToolTip="Move X pane to the left side" />
            <Button
                x:Name="CollapseXPaneButton"
                MinWidth="34"
                Content="Collapse"
                Click="OnCollapseXPaneClicked"
                Style="{StaticResource XChromeButtonStyle}" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,9,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="XBackButton" Content="Back" Click="OnXBackClicked" Style="{StaticResource XChromeButtonStyle}" ToolTipService.ToolTip="Back" />
            <Button x:Name="XForwardButton" Content="Forward" Click="OnXForwardClicked" Style="{StaticResource XChromeButtonStyle}" ToolTipService.ToolTip="Forward" />
            <Button x:Name="XHomeButton" Content="Home" Click="OnXHomeClicked" Style="{StaticResource XChromeButtonStyle}" ToolTipService.ToolTip="Home" />
            <Button x:Name="XRefreshButton" Content="Refresh" Click="OnXRefreshClicked" Style="{StaticResource XChromeButtonStyle}" ToolTipService.ToolTip="Refresh" />
          </StackPanel>
          <TextBlock x:Name="XCopyStatusText" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Foreground="#FFB347" FontSize="12" TextTrimming="CharacterEllipsis" />
          <Button x:Name="XOverflowButton" Grid.Column="2" Content="..." Click="OnXOverflowClicked" Style="{StaticResource XChromeButtonStyle}" ToolTipService.ToolTip="More X actions" />
        </Grid>

        <!-- Ad blocker indication: one muted line, collapsed when the ad blocker is active or its state is unknown. -->
        <TextBlock
            x:Name="XAdBlockIndicationText"
            Grid.Row="2"
            Margin="0,7,0,0"
            Foreground="#85888E"
            FontSize="12"
            MaxLines="1"
            TextWrapping="NoWrap"
            TextTrimming="CharacterEllipsis"
            Visibility="Collapsed" />

        <Border
            x:Name="XOverflowPanel"
            Grid.Row="3"
            HorizontalAlignment="Right"
            Width="190"
            Margin="0,8,0,0"
            Padding="6"
            Background="#070707"
            BorderBrush="#242426"
            BorderThickness="1"
            Visibility="Collapsed">
          <StackPanel Spacing="5">
            <Button x:Name="XOpenExternalMenuItem" Content="Open External" Click="OnXOpenExternalClicked" Style="{StaticResource XOverflowMenuButtonStyle}" />
            <Button x:Name="XCopyPostLinkMenuItem" Content="Copy Post Link" Click="OnXCopyPostLinkClicked" Style="{StaticResource XOverflowMenuButtonStyle}" />
            <Button x:Name="XClearSessionMenuItem" Content="Clear Session" Click="OnXClearSessionClicked" Style="{StaticResource XOverflowMenuButtonStyle}" />
            <Border Height="1" Margin="2,3" Background="#242426" />
            <Button x:Name="XExtensionsMenuItem" Content="Ad Blocker..." Click="OnXExtensionsClicked" Style="{StaticResource XOverflowMenuButtonStyle}" />
          </StackPanel>
        </Border>
      </Grid>

      <Border
          x:Name="XErrorBanner"
          Grid.Row="1"
          Padding="10,7"
          Background="#211116"
          BorderBrush="#4B252F"
          BorderThickness="0,0,0,1"
          Visibility="Collapsed">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="XStatusText" Foreground="#FFB8C0" FontSize="12" TextWrapping="Wrap" />
          <Button
              x:Name="XRetryButton"
              Grid.Column="1"
              Content="Retry X"
              Click="OnXRetryClicked"
              Style="{StaticResource XChromeButtonStyle}" />
        </Grid>
      </Border>

      <controls:WebView2 x:Name="XWebView" Grid.Row="2" />
    </Grid>
  </Grid>
</Window>
